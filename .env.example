# =============================================
# JJ Desserts - Environment variables
# Copy this file to `.env` and fill in real values
# =============================================

# Sanity CMS (get these from sanity.io after creating a project)
PUBLIC_SANITY_PROJECT_ID=your-project-id-here
PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-write-token-here

# Stripe (get these from dashboard.stripe.com)
# Use TEST keys (pk_test_..., sk_test_...) during development
# Switch to LIVE keys (pk_live_..., sk_live_...) only when ready to launch
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Pago con tarjeta en el carrito. Interruptor único:
#   true  -> solo "Pagar con tarjeta" (Stripe); el botón anterior se oculta.
#   otro  -> solo "Enviar Pedido" (pedido a n8n sin cobro, como siempre).
# Mantener desactivado en Netlify hasta tener las claves LIVE de Stripe.
PUBLIC_PAGOS_TARJETA=false

# n8n: aviso de pedidos PAGADOS con tarjeta (lo llama el webhook de Stripe).
# Vacío en local para que las pruebas no manden correos a Jose.
N8N_ORDER_WEBHOOK_URL=

# Site config
PUBLIC_SITE_URL=http://localhost:4321
SALES_TAX_RATE=0.0825
